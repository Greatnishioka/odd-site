{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2024"],
		"types": ["./worker-configuration.d.ts"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "worker-configuration.d.ts"],
	// ブラウザ用の JS は src/client/tsconfig.json で検査する（Worker の型とブラウザの型がぶつかるため）
	"exclude": ["src/client"]
}
